---
import ResourceCard from "./ResourceCard.astro";

import type { Resource } from "../server/types";
interface Props {
  resource: Resource;
}
const { resource } = Astro.props;
const { name, site } = resource;
---

<div class="resource-panel">
  <h2
    class="font-semibold mb-3.75 text-shadow-sm"
    id={name}
  >
    {name}
  </h2>

  <ul
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3.75"
  >
    {
      site.map((item) => (
        <li>
          <ResourceCard site={item} />
        </li>
      ))
    }
  </ul>
</div>
