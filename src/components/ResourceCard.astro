---
import { Image } from "astro:assets";

import type { ResourceItem } from "../server/types";
interface Props {
  site: ResourceItem;
}
const { site } = Astro.props;
const { name, description, url } = site;
const image = site.image ?? "https://ico.kucat.cn/get.php?url=" + url;
---

<!-- 网站卡片 -->
<a
  class="resource-card flex h-full rounded-xl group bg-base-100 hover:scale-105"
  href={url}
  target="_blank"
  rel="noreferrer"
  data-name={name.toLowerCase()}
  data-desc={(description ?? "").toLowerCase()}
>
  <div class="p-3.75">
    <div class="flex items-center h-8 w-full">
      <!-- 网站图片 -->
      <div class="flex-none flex items-center justify-center size-8 mr-3.75 overflow-hidden">
        <Image src={image} alt={site.name} width="32" height="32" />
      </div>

      <!-- 网站名称 -->
      <h3 class="flex-1 font-semibold">{name}</h3>
    </div>

    <!-- 网站描述 -->
    {description && <p class="mt-3.5 text-sm line-clamp-3">{description}</p>}
  </div>
</a>

<style>
  @import "tailwindcss";

  .resource-card {
    transition: scale .3s cubic-bezier(.68, -.55, .265, 1.55);
  }
</style>