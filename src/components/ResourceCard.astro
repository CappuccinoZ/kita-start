---
import { Image } from "astro:assets";

import type { ResourceItem } from "../server/types";
interface Props {
  site: ResourceItem;
}
const { site } = Astro.props;
const { name, description, url } = site;
const image = site.image ?? "https://ico.kucat.cn/get.php?url=" + url;
---

<!-- 网站卡片 -->
<a
  class="resource-card flex h-full rounded-xl group"
  href={url}
  target="_blank"
  rel="noreferrer"
  data-name={name.toLowerCase()}
  data-desc={(description ?? "").toLowerCase()}
>
  <div class="p-3.75">
    <div class="flex items-center h-8">
      <!-- 网站图片 -->
      <div class="flex-none size-9 p-0.5 mr-3.75 group-hover:bg-white overflow-hidden transition-all duration-300">
        <Image src={image} alt={site.name} width="32" height="32" />
      </div>

      <!-- 网站名称 -->
      <h3 class="flex-1 font-semibold truncate">{name}</h3>
    </div>

    <!-- 网站描述 -->
    {description && <p class="mt-3.5 text-sm line-clamp-3">{description}</p>}
  </div>
</a>

<style>
  @import "tailwindcss";

  .resource-card {
    background-color: rgba(255, 244, 242, 0.8);
    box-shadow: 5px 5px 0 rgba(186, 187, 165, 0.6);
    transition: all .3s cubic-bezier(.68, -.55, .265, 1.55);
  }


  .resource-card:hover{
    background-color: #50aa32;
    color: #fff;
    @apply scale-105;
  }
</style>