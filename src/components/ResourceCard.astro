---
import { Image } from "astro:assets";

import type { ResourceItem } from "../server/types";
interface Props {
  site: ResourceItem;
}
const { site } = Astro.props;
const { name, description, url } = site;
const image = site.image ?? "https://ico.kucat.cn/get.php?url=" + url;
---

<!-- 网站卡片 -->
<a
  class="resource-card card h-full bg-base-100 border border-base-300 rounded-xl shadow-md"
  href={url}
  target="_blank"
  rel="noreferrer"
>
  <div class="card-body py-4">
    <div class="card-title">
      <!-- 网站图片 -->
      <div class="flex-none h-8 w-8 mr-3 rounded overflow-hidden">
        <Image src={image} alt={site.name} width="32" height="32" />
      </div>

      <!-- 网站名称 -->
      <h3 class="flex-1 truncate">{name}</h3>
    </div>

    <!-- 网站描述 -->
    {description && <p class="line-clamp-3">{description}</p>}
  </div>
</a>
